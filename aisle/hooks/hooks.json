{
  "modules": [
    "./update.mjs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/listen.sh\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/listen.sh\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 604800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__listen_here",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/listen.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/listen.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(listen_here|whoami|read_chat|post_message)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/listen.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
